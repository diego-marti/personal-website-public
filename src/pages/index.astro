---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "../config/site";
import { sortByDate } from "../utils/sortByDate";
import PublicationItem from "../components/PublicationItem.astro";
import BlogItem from "../components/BlogItem.astro";
import ProjectItem from "../components/ProjectItem.astro";

// Get all content from collections
const publications = await getCollection("publications");
const blogPosts = await getCollection("blog");
const projects = await getCollection("projects");
const bioEntries = await getCollection("bio");

// Sort all collections by date
const sortedPublications = publications.sort(sortByDate);
const sortedBlogPosts = blogPosts.sort(sortByDate);
const sortedProjects = projects.sort(sortByDate);

// Select newest few entries
const { publications: pubConfig, blog: blogConfig, projects: projConfig } =
    siteConfig.sections;

const visiblePublications = sortedPublications.slice(0, pubConfig.maxItems);
const visibleBlogPosts = sortedBlogPosts.slice(0, blogConfig.maxItems);
const visibleProjects = sortedProjects.slice(0, projConfig.maxItems);

// The bio is a single entry; render its markdown body if it exists
const BioContent =
    bioEntries.length > 0 ? (await bioEntries[0].render()).Content : null;
---

<Layout title={siteConfig.metadata.title}>
	<section id="intro" class="intro-section">
		<div class="intro-content">
			<div class="intro-text">
				{siteConfig.intro.text.map((paragraph) => (
					<p>{paragraph}</p>
				))}
				<div class="social-links">
					<a
						href={siteConfig.social.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn"
					>
						<svg
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="currentColor"
						>
							<path
								d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
							></path>
						</svg>
					</a>
					{
						siteConfig.social.twitter && (
							<a
								href={siteConfig.social.twitter}
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Twitter"
							>
								<svg
									width="18"
									height="18"
									viewBox="0 0 24 24"
									fill="currentColor"
								>
									<path
										d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
									></path>
								</svg>
							</a>
						)
					}
					{
						siteConfig.social.scholar && (
							<a
								href={siteConfig.social.scholar}
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Google Scholar"
							>
								<svg
									width="18"
									height="18"
									viewBox="0 0 24 24"
									fill="currentColor"
								>
									<path
										d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"
									></path>
								</svg>
							</a>
						)
					}
					{
						siteConfig.social.github && (
							<a
								href={siteConfig.social.github}
								target="_blank"
								rel="noopener noreferrer"
								aria-label="GitHub"
							>
								<svg
									width="18"
									height="18"
									viewBox="0 0 24 24"
									fill="currentColor"
								>
									<path
										d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
									></path>
								</svg>
							</a>
						)
					}
					{
						siteConfig.social.email && (
							<a
								href={`mailto:${siteConfig.social.email}`}
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Email"
							>
								<svg
									width="18"
									height="18"
									viewBox="0 0 24 24"
									fill="currentColor"
								>
									<path
										d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
									></path>
								</svg>
							</a>
						)
					}
				</div>
			</div>
			<div class="profile-image">
				<img src={siteConfig.profileImage} alt={siteConfig.name.full} />
			</div>
		</div>
	</section>

	{
		sortedPublications.length > 0 ? (
			<section id="publications" class="section">
				<h2>Publications</h2>
				<div class="content">
					<div class="publications-list">
						{visiblePublications.map((publication) => (
							<PublicationItem publication={publication} />
						))}
					</div>
					{sortedPublications.length > pubConfig.maxItems && (
						<a href="/publications" class="show-more link-muted">
							Show more
						</a>
					)}
				</div>
			</section>
		) : null
	}

	{
		sortedBlogPosts.length > 0 ? (
			<section id="blog" class="section">
				<h2>Blog</h2>
				<div class="content">
					<div class="blog-list">
						{visibleBlogPosts.map((post) => (
							<BlogItem post={post} />
						))}
					</div>
					{sortedBlogPosts.length > blogConfig.maxItems && (
						<a href="/blog" class="show-more link-muted">
							Show more
						</a>
					)}
				</div>
			</section>
		) : null
	}

	{
		sortedProjects.length > 0 ? (
			<section id="projects" class="section">
				<h2>Projects</h2>
				<div class="content">
					<p>
						{siteConfig.sections.projects.description}
					</p>
					<div class="projects-list">
						{visibleProjects.map((project) => (
							<ProjectItem project={project} />
						))}
					</div>
					{sortedProjects.length > projConfig.maxItems && (
						<a href="/projects" class="show-more link-muted">
							Show more
						</a>
					)}
				</div>
			</section>
		) : null
	}

	{
		BioContent ? (
			<section id="bio" class="section">
				<h2>Bio</h2>
				<div class="content">
					<BioContent />
				</div>
			</section>
		) : null
	}
</Layout>

<style>
	.intro-section {
		display: flex;
		align-items: center;
		padding: 1.5rem 0;
	}

	.intro-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 3rem;
	}

	.intro-text {
		flex: 1;
		max-width: 65%;
	}

	.intro-text p {
		font-size: 1rem;
		margin-bottom: 1rem;
		color: #555;
		max-width: 600px;
	}

	.social-links {
		display: flex;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.04);
		color: #555;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.social-links a:hover {
		background: rgba(0, 0, 0, 0.08);
		color: #222;
	}

	.profile-image {
		flex-shrink: 0;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.profile-image img {
		width: 200px;
		height: 200px;
		border-radius: 50%;
		object-fit: cover;
	}

	@media (max-width: 768px) {
		.intro-content {
			text-align: center;
			gap: 2rem;
		}
	}
</style>
