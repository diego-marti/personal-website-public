---
import type { CollectionEntry } from "astro:content";

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
---

<article class="entry-item">
    <div class="entry-thumbnail">
        {project.data.thumbnail ? (
            <img src={project.data.thumbnail} alt={project.data.title} />
        ) : (
            <div class="placeholder-thumbnail" />
        )}
    </div>
    <div class="entry-info">
        <h3 class="entry-title">{project.data.title}</h3>
        <div class="tldr">{project.data.tldr}</div>
        <div class="meta year">{project.data.year}</div>
        <div class="entry-links">
            <a href={`/projects/${project.slug}`} class="link-muted">
                Read more
            </a>
            {project.data.code && (
                <a
                    href={project.data.code}
                    class="link-muted"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Code
                </a>
            )}
        </div>
    </div>
</article>

<style>
    /* Spacing only; appearance comes from the global .meta / .entry-* classes */
    .tldr {
        margin-bottom: 0.5rem;
    }

    .year {
        margin-bottom: 0.5rem;
        font-weight: bold;
    }
</style>
